{
  "compilerOptions": {
    // 目标环境
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    
    // 输出配置
    "outDir": "./dist",
    "rootDir": "./",
    
    // 类型检查
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    
    // 其他重要配置
    "allowJs": false,
    "noEmit": true,  // tsx 不生成输出文件，只类型检查
    "isolatedModules": true,
    
    // 类型定义
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "**/*.ts"
, "scripts/Fe/web/src/components/MemoryPanel.tsx", "scripts/Fe/web/src/hooks/useMemoryStore.tsx"  ],
  "exclude": [
    "node_modules",
    "dist",
    ".yarn"
  ]
}
